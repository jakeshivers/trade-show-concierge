# Local development. Nothing here is required to run the app — see SCOPE.md §9.

# Embedded Postgres location (PGlite). Defaults to ./.pglite
PGLITE_PATH=./.pglite

# Dev-only actor selection, standing in for a session until Clerk lands at step 7.
# Any seeded email works; these exercise the three roles:
#   shelley@northwindrobotics.test     admin
#   marcus@northwindrobotics.test   travel_manager
#   priya@northwindrobotics.test    member
DEV_ACTOR_EMAIL=shelley@northwindrobotics.test

# ── Flight booking ──────────────────────────────────────────────────────────
# All three are absent by default, and the app runs fine without them: with no
# key the Duffel adapter reports itself unconfigured and the spine runs on the
# `recorded` provider, which cannot buy anything under any configuration.

# A Duffel test key (test_...) enables real search. Live keys start with live_.
# DUFFEL_ACCESS_TOKEN=

# The flag. Absent or anything but exactly "true" means dry run — the whole
# pipeline runs and writes a booking row stamped live:false. SCOPE.md §6c rail 4.
# FLIGHT_BOOKING_LIVE=false

# The hard ceiling in integer cents, enforced inside the provider at the moment
# of purchase and independent of the policy engine. REQUIRED when
# FLIGHT_BOOKING_LIVE=true: the adapter refuses to buy without one, because an
# unbounded live purchaser is not a configuration worth supporting.
# FLIGHT_BOOKING_MAX_CENTS=250000

# ── Auth ────────────────────────────────────────────────────────────────────
# Both keys present switches `getActor()` from DEV_ACTOR_EMAIL to real Clerk
# sessions, and the switch is one-way: with Clerk configured, DEV_ACTOR_EMAIL is
# never consulted again, even if a lookup fails. Absent, the app runs on the dev
# seam with no accounts of any kind. SCOPE.md §3.
#
# Signing in is not provisioning: a verified Clerk account whose email matches no
# `users` row gets a "no access" page, and nothing is created for it.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
